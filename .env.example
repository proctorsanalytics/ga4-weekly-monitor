GA4_PROPERTIES_JSON='[{"name":"Example website","domain":"example.com","propertyId":"YOUR_PROPERTY_ID"}]'

# Use either Application Default Credentials (recommended in hosted environments),
# or provide both service-account fields below.
# GOOGLE_CLIENT_EMAIL=ga4-monitor@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

AGENTMAIL_API_KEY=am_xxxxxxxxx
AGENTMAIL_INBOX_ID=alerts@example.com
EMAIL_TO=you@example.com
CHANGE_THRESHOLD_PERCENT=10
DATABASE_URL=postgres://username:password@host:5432/database
DASHBOARD_USERNAME=dashboard-user
DASHBOARD_PASSWORD=change-me
# Railway supplies PORT for the dashboard service.
